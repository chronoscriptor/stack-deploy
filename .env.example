# Chronoscriptor Stack Deploy — Environment Variables
# Copy this file to .env and fill in your values

# Shared Infrastructure
POSTGRES_PASSWORD=change_me_secure_random
POSTGRES_USER=agent
POSTGRES_DB=agent_stack

# n8n
N8N_ENCRYPTION_KEY=change_me_secure_random

# WordPress
WORDPRESS_DB_PASSWORD=change_me_secure_random

# Mattermost
MATTERMOST_DB_PASSWORD=change_me_secure_random

# EspoCRM
ESPOCRM_DB_PASSWORD=change_me_secure_random
ESPOCRM_API_KEY=

# Vikunja
VIKUNJA_DB_PASSWORD=change_me_secure_random
VIKUNJA_JWT_SECRET=change_me_secure_random

# Baserow
BASEROW_DB_PASSWORD=change_me_secure_random

# Plane
PLANE_DB_PASSWORD=change_me_secure_random
PLANE_SECRET_KEY=change_me_secure_random

# Wiki.js
WIKIJS_DB_PASSWORD=change_me_secure_random

# Gitea
GITEA_DB_PASSWORD=change_me_secure_random
GITEA_SECRET_KEY=change_me_secure_random